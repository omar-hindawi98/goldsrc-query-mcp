{
	"name": "goldsrc-query-mcp",
	"version": "1.0.0",
	"description": "MCP server for querying GoldSrc game servers",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"goldsrc-query-mcp": "dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/index.js",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"check:ci": "biome check",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run check:ci && npm run build && npm test",
		"prepare": "husky"
	},
	"keywords": [
		"goldsrc",
		"half-life",
		"counter-strike",
		"mcp",
		"model-context-protocol",
		"server-query"
	],
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"goldsrc-query": "^1.1.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.2.0",
		"husky": "^9.1.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=20.12.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/omar-hindawi98/goldsrc-query-mcp"
	},
	"author": "Omar Hindawi",
	"license": "MIT"
}
